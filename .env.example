# Backend loads this root file. Never commit actual credentials.
SUPABASE_URL=https://uetkeamhjxvzjsqsjcwv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Storage uses this publishable key plus each signed-in user's bearer token.
# No SUPABASE_SECRET_KEY or service-role key is needed for normal use.
LEARNING_STORAGE_BUCKET=learning-materials
# Prefer the Supabase session pooler on port 5432 for IPv4 networks.
DATABASE_URL=
MIGRATION_DATABASE_URL=
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_ENABLED=false
AI_DEMO_FALLBACK=true
# Native RunPod queue alternative (server-side only; no /run suffix):
# AI_PROVIDER=runpod
# AI_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID
# AI_MODEL=YOUR_DEPLOYED_MODEL
# AI_API_KEY=YOUR_RUNPOD_KEY
# Explicit upload/analysis buttons start AI actions; the UI names each provider.
AI_TIMEOUT_SECONDS=180
AI_MAX_OUTPUT_TOKENS=4096
# Zero disables these local count caps; the usage ledger remains active.
# Provider credit/rate limits still apply. /run is never resubmitted automatically.
AI_MAX_CALLS=0
AI_CALLS_PER_USER_HOUR=0
# Separate real-vacancy provider. Generate a free JSearch key; never NEXT_PUBLIC_.
JSEARCH_API_KEY=
JSEARCH_BASE_URL=https://api.openwebninja.com/jsearch
JSEARCH_API_ID=jsearch
# Local monthly search-call ceiling; provider quota remains authoritative.
JSEARCH_MAX_CALLS=25
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE=true
# Optional executables for scanned/image CVs and preserving Word page layout.
# Leave blank to auto-detect installed tools or Windows .tools/tesseract/tesseract.exe.
# Portable tools are ignored by Git and must be supplied separately after cloning.
# Text PDFs and DOCX need neither executable.
TESSERACT_CMD=
LIBREOFFICE_CMD=

# Optional SDG wording only; off by default. No key is needed for curated mappings.
SDG_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
